# Weave — region configuration. Copy to .env and fill in for your region.
#
#     cp .env.example .env
#
# docker compose reads .env automatically. Together with a region config in
# gis/regions/, this file is the only place a place name appears — no service,
# script, schema or SQL file names a location.

# ---------------------------------------------------------------- GIS region
# Which region config the loader and the discovery tool use.
# Copy gis/regions/TEMPLATE.yml to start your own.
GIS_REGION_CONFIG=gis/regions/melbourne-water.example.yml

# ------------------------------------------------ real feed: water telemetry
# A Kisters hydrometry service and the gauges to poll. HYDRO_API picks the
# adapter: kiwis (a KiWIS service, such as the Bureau of Meteorology's Water
# Data Online) or hydstra (a Hydstra webservice.exe). The values below are the
# Bureau's service with three Yarra gauges as a worked example; its hourly
# means arrive about a day late. Browse gauge numbers in the portal's map.
# The Hydstra example, Victoria's WMIS, no longer returns current data.
HYDRO_API=kiwis
HYDRO_URL=https://www.bom.gov.au/waterdata/services
HYDRO_PROVIDER=bom-wdo
HYDRO_SITES=229143B,229200B,229135A
HYDRO_INTERVAL_S=900
HYDRO_TS_NAME=DMQaQc.Merged.HourlyMean.HR

# --- real feed: reservoir storage volumes (ingest-storage) ---------------------
# A Kisters KiWIS service that publishes daily storage volumes. The Bureau of
# Meteorology's Water Data Online serves storages Australia-wide; most
# suppliers license their data CC BY, some set their own terms, and the
# service rate-limits, so the poller keeps calls few. STORAGE_PROVIDER is the
# source label the console shows. STORAGE_BBOX keeps only storages inside it
# (xmin,ymin,xmax,ymax, as the region config's extent). List what it finds,
# without writing, with: docker compose run --rm ingest-storage python storage_poller.py --list
STORAGE_URL=https://www.bom.gov.au/waterdata/services
STORAGE_PROVIDER=Bureau of Meteorology Water Data Online
STORAGE_BBOX=143.5,-38.9,146.7,-37.0
STORAGE_INTERVAL_S=21600
# After a failed run (the service drops out for minutes at a time).
STORAGE_RETRY_S=900
STORAGE_BACKFILL_DAYS=90
# A storage gauge is linked to an asset whose name shares a distinctive word
# within STORAGE_NAME_MATCH_M (a dam's point is often mid-lake), else to the
# nearest asset within STORAGE_MATCH_M; never to one smaller than its volume.
STORAGE_MATCH_M=1500
STORAGE_NAME_MATCH_M=15000

# ------------------------------------------------------------------- naming
# Avro namespace for the generated Datagen schemas.
SCHEMA_NAMESPACE=weave

# ------------------------------------------------------------------ console
# The console page at http://localhost:8090. Its map has a basemap picker
# (OpenStreetMap, CARTO, Esri, OpenTopoMap, and Google when configured below).
# Every pan and zoom asks the chosen tile server for the area being viewed,
# so the default draws no basemap. CONSOLE_BASEMAP sets the starting choice:
# none | osm | carto-light | carto-dark | esri-imagery | esri-topo |
# opentopomap | custom | google-roadmap | google-satellite. Each browser
# remembers its own pick after that.
CONSOLE_PORT=8090
CONSOLE_BASEMAP=
# Optional extra basemap, listed as "custom".
CONSOLE_TILE_URL=
CONSOLE_TILE_ATTRIBUTION=
# auto follows the page theme (header toggle or OS); dark or light forces one.
# Dark switches CARTO to its dark variant and inverts other light tiles in
# the browser, so it adds no tile provider. Imagery and Google stay as-is.
CONSOLE_TILE_STYLE=auto
# Google basemaps use the official Map Tiles API. Create a key with that API
# enabled, restrict it, and set the region (CLDR code) the tiles are labelled
# for; Google is left out while either is empty. Google's terms also require
# its logo on the map, which the console does not draw.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=
GOOGLE_MAPS_LANGUAGE=en
# Flink's REST endpoint as seen from inside the compose network.
FLINK_URL=http://flink-jobmanager:9081

# ----------------------------------------------------------------- console
# Three roles on one address: anonymous visitors view, the demo login (open to
# everyone, password shown on the form) tries steps, and the admin login runs
# every step on the live stack (console/access.py).

# --- 1. Mode
# - unified: the `console` service serves everyone on CONSOLE_PORT and holds
#   the Docker socket, so the role check is the only thing between a visitor
#   and the host. Use it with a strong admin password (and TOTP). No
#   console-public, and section 5 is unused.
# - admin (default): two consoles. The loopback `console` holds the socket;
#   `console-public` (compose profile "public") never does and relays to it.
CONSOLE_MODE=admin

# --- 2. Reach
# Host names the console answers to. Add the public host name when hosted;
# "console" lets console-public reach the relay routes by service name.
CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1,console
# 1 when served over https (hosted); 0 for http on loopback.
CONSOLE_COOKIE_SECURE=0

# --- 3. Database
# Unified mode: the read-only role, because strangers can reach the service:
#   postgresql://weave_reader:weave_reader@postgres:5432/weave_twin
# Two consoles: leave blank (the admin console uses the weave role).
CONSOLE_TWIN_DSN=

# --- 4. Logins
# Demo: open to everyone, the password is shown on the form. CONSOLE_DEMO=0
# removes the login.
CONSOLE_DEMO=1
CONSOLE_DEMO_PASSWORD=demo
# Admin and session: leave these three blank, ./scripts/init-secrets.sh fills
# them (add --totp for the authenticator secret) and asks for the admin
# password. A blank session secret is a fresh one per start, which logs
# everyone out on restart.
CONSOLE_ADMIN_PASSWORD_HASH=
CONSOLE_ADMIN_TOTP_SECRET=
CONSOLE_SESSION_SECRET=

# --- 5. Two consoles only
# The public console's port and host names, and the tokens it relays with:
# the demo one admits only the safe actions, the admin one every action. A
# blank demo token turns the relay off (everything simulated). init-secrets.sh
# fills the tokens.
CONSOLE_PUBLIC_PORT=8091
CONSOLE_PUBLIC_HOSTS=localhost,127.0.0.1
CONSOLE_RELAY_TOKEN=
CONSOLE_RELAY_ADMIN_TOKEN=

# --------------------------------------------------------- GIS clients
# OGC API Features for QGIS, ArcGIS Pro and GDAL, served by pg_featureserv
# as the read-only role weave_reader (postgres/init/04_gis_reader.sql).
FEATURESERV_PORT=9000
FEATURESERV_PUBLIC_URL=http://localhost:9000

# ------------------------------------------------ Elasticsearch / Kibana
# Not region settings — where the ELK read copy goes. Leave ELASTICSEARCH_URL
# empty and scripts/elk-up.sh starts Weave's own cluster. Set it to reuse an
# existing one; if that cluster isn't answering, a local one starts instead.
# URLs are as seen from inside Weave's containers, which join ELK_NETWORK —
# use the host name the cluster's TLS certificate was issued for.
# (elk-up.sh prints these values when it finds a cluster already running.)
ELK_NETWORK=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# CA certificate file name under elk/certs/, for a self-signed cluster.
ELASTICSEARCH_CA=
KIBANA_URL=

# --- hydraulic model --------------------------------------------------------
# The simulator and the seeder both read these: synthetic DMAs are placed on
# the pipes the model keeps, so change them together and then re-seed and
# rebuild. Only pipes a reservoir feeds are modelled, so networks published
# without reservoirs stay out whatever the cap; 200000 lets a fully supplied
# region be modelled whole. Solves grow faster than linearly (about 3.5 min
# for 160,000 pipes on two cores, slower under amd64 emulation on Apple
# Silicon), so lower it on a small host. Each solve logs its time.
SIM_MAX_PIPES=200000
SIM_MAX_SNAP_M=500
# Optional snap limit per supply type; blank uses SIM_MAX_SNAP_M. A service
# reservoir feeds the network and may sit some way off it; a storage dam is
# usually catchment storage behind a treatment plant. Either way a reservoir
# snaps to its nearest node with a usable pipe, and the build logs any nearer
# node it passed over. Re-seed and rebuild after changing these.
SIM_MAX_SNAP_M_SERVICE_RESERVOIR=
SIM_MAX_SNAP_M_STORAGE_DAM=
# Supply heads. Public GIS has no reservoir levels, so "zoned" cuts the
# supplied network into elevation bands, each at a grade line that keeps its
# nodes between the minimum and maximum service pressure, joined by PRVs, with
# boosters where no reservoir reaches. 20 and 80 m are the WSA 03 minimum and
# maximum allowable service pressures; the margin (an assumption) allows for
# headloss. "ground" is the earlier rule: ground level plus 10 m per reservoir.
SIM_HEAD_MODE=zoned
# Joining the network's pieces (model/gaps.py), real before synthetic. A dead
# end within SIM_TJUNCTION_M of another pipe's side splits that real pipe
# there. Pieces still without supply are joined by a synthetic gap if within
# SIM_BRIDGE_SMALL_M, else by a synthetic bridge main within
# SIM_BRIDGE_LARGE_M (0 turns bridges off). The three distances are
# assumptions. Every change and its reason goes to asset.model_link and
# /app/out/model_links.csv. The seeder reads these too: re-seed after changes.
SIM_TJUNCTION_M=2
SIM_BRIDGE_SMALL_M=50
SIM_BRIDGE_LARGE_M=5000
SIM_MIN_SERVICE_PRESSURE_M=20
SIM_MAX_SERVICE_PRESSURE_M=80
SIM_HEAD_MARGIN_M=5
# Residuals a DMA needs before it gets a status (8 = two hours of 15-minute
# solves). Higher is steadier but leaves a fresh stack blank for longer.
SIM_RESIDUAL_MIN_SAMPLES=8
# Hours of per-element solve results kept in twin.sim_result. Only the latest
# run is read; a whole-network solve writes about 240,000 rows.
SIM_RESULT_RETENTION_HOURS=24

# --- synthetic water meters ---------------------------------------------------
# ingest-meters reports every meter in ref.water_meter each interval, from
# typical residential and commercial use (ingest/demand_profiles.py). The
# daily shape follows local time, so set the region's IANA time zone.
METER_INTERVAL_S=900
METER_TZ=Australia/Melbourne
# Readings are random within these fractions of their expected value: each
# interval within +/-METER_INTERVAL_RANGE, each day within +/-METER_DAY_RANGE.
METER_INTERVAL_RANGE=0.5
METER_DAY_RANGE=0.15

# ingest-backfill fills gaps in the synthetic meter and logger tables once the
# feed has come back (a sleeping host stops the generators, not the water use).
BACKFILL_INTERVAL_S=60
BACKFILL_MAX_AGE_DAYS=7
# Silence this long in the loggers counts as a gap; live spacing is about 1.5 s.
BACKFILL_PRESSURE_GAP_S=300
BACKFILL_PRESSURE_EVERY_S=1.5
